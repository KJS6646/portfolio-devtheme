---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

const MAX_LEVEL = 5;
const countBy = (code: string) =>
  siteConfig.projects.filter((p) => p.system === code).length;
const { journey } = siteConfig;
---

{
  hasProjects && (
    <section id="projects" class="px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-28">
      <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <SectionHeader index="02" title="PROJECTS" subtitle="성장 스토리 · 수행 프로젝트" />

        <div class="lg:col-span-8 space-y-12">
          {/* ---------- QUEST LOG (성장 스토리) ---------- */}
          <div>
            <p class="font-pixel text-sm text-[var(--text)]">QUEST LOG</p>
            <p class="mt-3 text-base sm:text-lg text-[var(--text)] leading-relaxed">{journey.intro}</p>

            {/* 스테이지 진행 바 */}
            <ol class="mt-6 flex flex-wrap items-center gap-2 font-pixel text-xs" aria-label="성장 단계">
              {siteConfig.systems.map((sys) => (
                <>
                  <li class="px-2 py-1 border-2 border-[var(--edge)] bg-[var(--panel-hi)] text-[var(--accent)]">{sys.code}</li>
                  <li class="text-[var(--muted)]" aria-hidden="true">▶</li>
                </>
              ))}
              <li class="px-2 py-1 border-2 border-[var(--edge)] bg-[var(--accent)] text-[var(--edge)]">AI</li>
            </ol>

            <div class="mt-8">
              {siteConfig.systems.map((sys, i) => {
                const count = countBy(sys.code);
                const isNow = i === siteConfig.systems.length - 1;
                return (
                  <>
                    <article class:list={["px-panel px-rivets p-5 sm:p-7", isNow && "stage-now"]}>
                      {/* 헤더 */}
                      <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2 font-pixel text-xs">
                          <span class="px-2 py-1 bg-[var(--accent)] text-[var(--edge)] border-2 border-[var(--edge)]">
                            STAGE {sys.stage}
                          </span>
                          {isNow && (
                            <span class="flex items-center gap-2 px-2 py-1 border-2 border-[var(--edge)] bg-[var(--panel-hi)] text-[var(--led)]">
                              <span class="px-led" style="width:8px;height:8px" /> NOW
                            </span>
                          )}
                        </div>
                        <span class="font-pixel text-xs text-[var(--muted)]">
                          {sys.company} · {sys.period}
                        </span>
                      </div>

                      <div class="mt-5 flex flex-wrap items-end justify-between gap-4">
                        <div>
                          <span class="font-pixel text-4xl sm:text-5xl text-[var(--accent)]" style="text-shadow: 3px 3px 0 var(--edge)">
                            {sys.code}
                          </span>
                          <p class="mt-2 text-xs text-[var(--muted)]">{sys.name}</p>
                          <p class="font-bold text-[var(--text)]">{sys.nameKo}</p>
                        </div>
                        {/* 난이도 */}
                        <div class="text-right">
                          <p class="font-pixel text-[10px] tracking-widest text-[var(--muted)] mb-1.5">DIFFICULTY</p>
                          <div class="flex gap-1" aria-label={`난이도 ${sys.level} / ${MAX_LEVEL}`}>
                            {Array.from({ length: MAX_LEVEL }, (_, n) => (
                              <span class:list={["lv-block", n < sys.level && "lv-block--on"]} />
                            ))}
                          </div>
                        </div>
                      </div>

                      {/* 스토리 */}
                      <h3 class="mt-6 text-lg sm:text-xl font-bold text-[var(--text)]">"{sys.storyTitle}"</h3>
                      <p class="mt-2 text-sm sm:text-base text-[var(--text)]/85 leading-relaxed">{sys.story}</p>

                      {/* 시스템 설명 + 역할 */}
                      <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-4 bg-[var(--bg-2)] border-2 border-[var(--edge)]">
                          <p class="font-pixel text-xs text-[var(--accent)] mb-2">WHAT IS {sys.code}?</p>
                          <p class="text-sm text-[var(--muted)] leading-relaxed">{sys.description}</p>
                        </div>
                        <div class="p-4 bg-[var(--bg-2)] border-2 border-[var(--edge)]">
                          <p class="font-pixel text-xs text-[var(--accent)] mb-2">MY ROLE</p>
                          <p class="text-sm text-[var(--muted)] leading-relaxed">{sys.role}</p>
                        </div>
                      </div>

                      {count > 0 && (
                        <button type="button" class="px-btn px-btn--ghost mt-5 text-sm" data-filter={sys.code}>
                          ▼ {sys.code} 프로젝트 {count}건 보기
                        </button>
                      )}
                    </article>

                    <div class="level-up" aria-hidden="true">
                      <span>▲ LEVEL UP</span>
                    </div>
                  </>
                );
              })}

              {/* NEXT: 지금 배우는 것 */}
              <article class="next-card p-5 sm:p-7">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="font-pixel text-xs px-2 py-1 bg-[var(--panel-hi)] text-[var(--accent)] border-2 border-dashed border-[var(--accent)]">
                    NEXT STAGE · LOADING<span class="loading-dots"></span>
                  </span>
                  <span class="font-pixel text-xs text-[var(--muted)]">LEARNING NOW</span>
                </div>
                <h3 class="mt-5 font-pixel text-2xl sm:text-3xl text-[var(--text)]" style="text-shadow: 3px 3px 0 var(--edge)">
                  {journey.next.title}
                </h3>
                <p class="mt-3 text-sm sm:text-base text-[var(--text)]/85 leading-relaxed">{journey.next.story}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {journey.next.tools.map((tool) => (
                    <span class="px-chip">{tool}</span>
                  ))}
                </div>
              </article>
            </div>
          </div>

          {/* ---------- 프로젝트 목록 ---------- */}
          <div id="project-log">
            <div class="flex items-center justify-between mb-4">
              <p class="font-pixel text-sm text-[var(--text)]">
                PROJECT LOG <span class="project-filter-label text-[var(--accent)]"></span>
              </p>
              <button type="button" class="filter-reset font-pixel text-xs text-[var(--muted)] hover:text-[var(--accent)]" data-filter="ALL" hidden>
                [ 전체 보기 ]
              </button>
            </div>
            <div class="space-y-6">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
                  : {};
                return (
                  <Component
                    {...linkProps}
                    data-system={project.system}
                    class="project-card block px-panel px-panel--hover p-6 sm:p-8"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <div class="flex items-center gap-2">
                        <span class="font-pixel text-xs px-2 py-1 bg-[var(--accent)] text-[var(--edge)] border-2 border-[var(--edge)]">
                          #{String(index + 1).padStart(2, "0")}
                        </span>
                        <span class="font-pixel text-xs px-2 py-1 bg-[var(--panel-hi)] text-[var(--accent)] border-2 border-[var(--edge)]">
                          {project.system}
                        </span>
                      </div>
                      {project.link && (
                        <span class="font-pixel text-xs text-[var(--accent)]">OPEN ↗</span>
                      )}
                    </div>
                    <h3 class="mt-4 text-lg sm:text-xl font-bold text-[var(--text)] leading-snug">
                      {project.name}
                    </h3>
                    <p class="mt-3 text-sm sm:text-base text-[var(--muted)] leading-relaxed">
                      {project.description}
                    </p>
                    {project.skills && project.skills.length > 0 && (
                      <div class="mt-5 flex flex-wrap gap-2">
                        {project.skills.map((skill) => (
                          <span class="px-chip px-chip--plain">{skill}</span>
                        ))}
                      </div>
                    )}
                  </Component>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  const cards = document.querySelectorAll<HTMLElement>(".project-card");
  const label = document.querySelector<HTMLElement>(".project-filter-label");
  const reset = document.querySelector<HTMLButtonElement>(".filter-reset");
  const log = document.getElementById("project-log");

  const apply = (code: string) => {
    cards.forEach((card) => {
      card.hidden = code !== "ALL" && card.dataset.system !== code;
    });
    if (label) label.textContent = code === "ALL" ? "" : `// ${code}`;
    if (reset) reset.hidden = code === "ALL";
  };

  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const code = btn.dataset.filter ?? "ALL";
      apply(code);
      if (code !== "ALL") log?.scrollIntoView({ behavior: "smooth", block: "start" });
    }),
  );
</script>

<style>
  .lv-block {
    width: 16px;
    height: 16px;
    background: var(--bg-2);
    border: 2px solid var(--edge);
  }

  .lv-block--on {
    background: var(--accent);
    box-shadow:
      inset 2px 2px 0 rgba(255, 255, 255, 0.35),
      inset -2px -2px 0 rgba(0, 0, 0, 0.25);
  }

  .stage-now {
    box-shadow:
      inset 3px 3px 0 rgba(255, 255, 255, 0.07),
      inset -3px -3px 0 rgba(0, 0, 0, 0.35),
      6px 6px 0 0 var(--edge),
      0 0 0 3px var(--accent);
  }

  .level-up {
    display: flex;
    justify-content: center;
    padding: 1.1rem 0;
    position: relative;
  }

  .level-up::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    border-left: 4px dashed var(--panel-hi);
  }

  .level-up span {
    position: relative;
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    padding: 0.3rem 0.6rem;
    color: var(--accent);
    background: var(--bg);
    border: 2px solid var(--panel-hi);
  }

  .next-card {
    position: relative;
    border: 3px dashed var(--accent);
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--accent) 6%, var(--panel)) 0 12px,
      var(--panel) 12px 24px
    );
  }

  .loading-dots::after {
    content: "";
    animation: dots 1.5s steps(4) infinite;
  }

  @keyframes dots {
    0% { content: ""; }
    25% { content: "."; }
    50% { content: ".."; }
    75% { content: "..."; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-dots::after {
      animation: none;
      content: "...";
    }
  }
</style>
