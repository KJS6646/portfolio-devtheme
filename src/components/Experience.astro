---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-28">
      <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <SectionHeader index="03" title="EXPERIENCE" subtitle="경력" />

        <div class="lg:col-span-8">
          <ol class="relative border-l-4 border-dashed border-[var(--panel-hi)] ml-2 space-y-10">
            {siteConfig.experience.map((exp, index) => (
              <li class="relative pl-8 sm:pl-10">
                <span
                  class="absolute -left-[14px] top-6 w-6 h-6 border-[3px] border-[var(--edge)]"
                  style={index === 0 ? "background: var(--accent)" : "background: var(--panel-hi)"}
                  aria-hidden="true"
                />
                <div class="px-panel px-rivets p-6 sm:p-8">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                    <div>
                      <h3 class="text-xl sm:text-2xl font-bold text-[var(--text)]">{exp.company}</h3>
                      <p class="mt-1 font-pixel text-sm text-[var(--accent)]">{exp.title}</p>
                    </div>
                    <span class="font-pixel text-xs text-[var(--muted)] whitespace-nowrap">
                      {exp.dateRange}
                    </span>
                  </div>
                  <ul class="mt-5 space-y-2.5">
                    {exp.bullets.map((bullet) => (
                      <li class="flex items-start gap-3 text-sm sm:text-base text-[var(--muted)]">
                        <span class="mt-2 w-2 h-2 shrink-0 bg-[var(--accent)]" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}
