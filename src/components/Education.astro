---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-28">
      <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <SectionHeader index="04" title="EDUCATION" subtitle="학력" />

        <div class="lg:col-span-8 space-y-6">
          {siteConfig.education.map((edu) => (
            <div class="px-panel px-rivets p-6 sm:p-8">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold text-[var(--text)]">{edu.school}</h3>
                  <p class="mt-1 font-pixel text-sm text-[var(--accent)]">{edu.degree}</p>
                </div>
                <span class="font-pixel text-xs text-[var(--muted)] whitespace-nowrap">
                  {edu.dateRange}
                </span>
              </div>
              {edu.achievements.length > 0 && (
                <ul class="mt-5 space-y-2.5">
                  {edu.achievements.map((achievement) => (
                    <li class="flex items-start gap-3 text-sm sm:text-base text-[var(--muted)]">
                      <span class="mt-2 w-2 h-2 shrink-0 bg-[var(--accent)]" />
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
