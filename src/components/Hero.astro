---
import { siteConfig } from "../config";
import SocialLinks from "./SocialLinks.astro";

const stats = [
  { value: siteConfig.careerYears, label: "YEARS", sub: "경력" },
  { value: String(siteConfig.projects.length), label: "PROJECTS", sub: "수행 프로젝트" },
  { value: String(siteConfig.certifications.length), label: "CERTS", sub: "자격증" },
];

/* ---------- 아이소메트릭 블록 탑 ---------- */
type Kind = "steel" | "accent";
const S = 44; // 블록 한 변
const DX = S * Math.cos(Math.PI / 6);
const DY = S / 2;

const p = (x: number, y: number, z: number): [number, number] => [
  (x - y) * DX,
  (x + y) * DY - z * S,
];

const blocks: [number, number, number, Kind][] = [
  // 1층
  [0, 0, 0, "steel"], [1, 0, 0, "steel"], [2, 0, 0, "steel"],
  [0, 1, 0, "steel"], [1, 1, 0, "steel"], [2, 1, 0, "steel"],
  [0, 2, 0, "steel"], [1, 2, 0, "accent"], [2, 2, 0, "steel"],
  // 2층
  [0, 0, 1, "steel"], [1, 0, 1, "steel"], [2, 0, 1, "accent"],
  [0, 1, 1, "steel"], [1, 1, 1, "steel"],
  // 3층
  [0, 0, 2, "accent"], [1, 0, 2, "steel"], [0, 1, 2, "steel"],
  // 4층
  [0, 0, 3, "steel"],
];

const palette: Record<Kind, { top: string; left: string; right: string }> = {
  steel: { top: "#5a6472", left: "#3b424d", right: "#2c323b" },
  accent: {
    top: "var(--accent)",
    left: "var(--accent-dark)",
    right: "var(--accent-deep)",
  },
};

const toPoints = (pts: [number, number][]) =>
  pts.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(" ");

// 면 안쪽에 철판 이음선(축소된 사각형)
const inset = (pts: [number, number][], k = 0.62) => {
  const cx = pts.reduce((s, [a]) => s + a, 0) / pts.length;
  const cy = pts.reduce((s, [, b]) => s + b, 0) / pts.length;
  return pts.map(([a, b]) => [cx + (a - cx) * k, cy + (b - cy) * k]) as [number, number][];
};

const cube = (x: number, y: number, z: number, kind: Kind) => {
  const top = [p(x, y, z + 1), p(x + 1, y, z + 1), p(x + 1, y + 1, z + 1), p(x, y + 1, z + 1)];
  const left = [p(x, y + 1, z + 1), p(x + 1, y + 1, z + 1), p(x + 1, y + 1, z), p(x, y + 1, z)];
  const right = [p(x + 1, y, z + 1), p(x + 1, y + 1, z + 1), p(x + 1, y + 1, z), p(x + 1, y, z)];
  const c = palette[kind];
  return [
    { pts: top, fill: c.top },
    { pts: left, fill: c.left },
    { pts: right, fill: c.right },
  ].map((f) => ({ points: toPoints(f.pts), inner: toPoints(inset(f.pts)), fill: f.fill }));
};

const sorted = [...blocks].sort((a, b) => a[0] + a[1] + a[2] - (b[0] + b[1] + b[2]));
const tower = sorted.map(([x, y, z, k]) => cube(x, y, z, k));
const floating = cube(2, 2, 2.2, "accent");

const all = [
  ...blocks.flatMap(([x, y, z]) => [p(x, y + 1, z), p(x + 1, y, z), p(x, y, z + 1), p(x + 1, y + 1, z)]),
  p(2, 3, 2.2),
  p(3, 2, 2.2),
  p(2, 2, 3.2),
];
const pad = 24;
const minX = Math.min(...all.map(([a]) => a)) - pad;
const maxX = Math.max(...all.map(([a]) => a)) + pad;
const minY = Math.min(...all.map(([, b]) => b)) - pad;
const maxY = Math.max(...all.map(([, b]) => b)) + pad;
const viewBox = `${minX.toFixed(0)} ${minY.toFixed(0)} ${(maxX - minX).toFixed(0)} ${(maxY - minY).toFixed(0)}`;
---

<div id="hero" class="relative isolate overflow-hidden flex flex-col"
  style="min-height: min(100svh, 960px)">
  <!-- 배경 광원 -->
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 900px 700px at 15% 20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%), radial-gradient(ellipse 700px 600px at 85% 70%, rgba(91, 141, 239, 0.10), transparent 70%);"
  >
  </div>

  <div
    class="flex-1 w-full mx-auto px-6 sm:px-12 md:px-16 lg:px-24 pt-28 pb-16 grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-12 items-center"
  >
    <div class="lg:col-span-7 min-w-0">
      <p class="font-pixel text-xs sm:text-sm text-[var(--muted)] flex items-center gap-3 px-rise">
        <span class="px-led"></span>
        SYSTEM ONLINE <span class="opacity-40">//</span> PLAYER_01
      </p>

      <p class="mt-8 font-pixel text-lg sm:text-2xl text-[var(--accent)] px-rise" style="animation-delay: 0.1s">
        Hello, World!
      </p>

      <h1
        class="mt-4 font-pixel text-6xl sm:text-7xl md:text-8xl xl:text-9xl leading-none text-[var(--text)] px-rise"
        style="animation-delay: 0.2s; text-shadow: 4px 4px 0 var(--accent-dark), 8px 8px 0 var(--edge);"
      >
        {siteConfig.name}
      </h1>

      <p
        class="mt-8 font-pixel text-base sm:text-xl md:text-2xl text-[var(--text)] px-rise"
        style="animation-delay: 0.3s"
      >
        <span class="text-[var(--accent)]">&gt;</span>
        <span data-typing={siteConfig.title}>{siteConfig.title}</span><span
          class="hero-cursor"
          aria-hidden="true"></span>
      </p>

      <p
        class="mt-6 max-w-2xl text-sm sm:text-base md:text-lg text-[var(--muted)] leading-relaxed border-l-4 border-[var(--accent)] pl-4 px-rise"
        style="animation-delay: 0.4s"
      >
        "{siteConfig.tagline}"
      </p>

      <div class="mt-10 grid grid-cols-3 gap-3 sm:gap-5 max-w-xl px-rise" style="animation-delay: 0.5s">
        {
          stats.map((s) => (
            <div class="px-panel px-rivets px-3 py-4 sm:px-5 sm:py-5">
              <div class="font-pixel text-2xl sm:text-4xl text-[var(--accent)]" style="text-shadow: 3px 3px 0 var(--edge)">
                {s.value}
              </div>
              <div class="mt-2 font-pixel text-[10px] sm:text-xs tracking-widest text-[var(--text)]">
                {s.label}
              </div>
              <div class="text-[11px] sm:text-xs text-[var(--muted)]">{s.sub}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-4 px-rise" style="animation-delay: 0.6s">
        <a href="#projects" class="px-btn">▶ 프로젝트 보기</a>
        <a href="#experience" class="px-btn px-btn--ghost">경력 보기</a>
        <SocialLinks />
      </div>
    </div>

    <!-- 블록 탑 -->
    <div class="hidden lg:flex lg:col-span-5 justify-center px-rise" style="animation-delay: 0.3s">
      <svg viewBox={viewBox} class="w-full max-w-[460px] h-auto drop-shadow-[10px_14px_0_rgba(0,0,0,0.45)]" aria-hidden="true">
        {
          tower.map((faces) => (
            <g>
              {faces.map((f) => (
                <>
                  <polygon points={f.points} style={`fill: ${f.fill}`} stroke="#090a0c" stroke-width="2.5" stroke-linejoin="miter" />
                  <polygon points={f.inner} fill="none" stroke="rgba(0,0,0,0.28)" stroke-width="2" />
                </>
              ))}
            </g>
          ))
        }
        <g class="hero-float">
          {
            floating.map((f) => (
              <>
                <polygon points={f.points} style={`fill: ${f.fill}`} stroke="#090a0c" stroke-width="2.5" />
                <polygon points={f.inner} fill="none" stroke="rgba(0,0,0,0.28)" stroke-width="2" />
              </>
            ))
          }
        </g>
      </svg>
    </div>
  </div>

  <div class="px-hazard"></div>
</div>

<script>
  const el = document.querySelector<HTMLElement>("[data-typing]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (el && !reduce) {
    const text = el.dataset.typing ?? "";
    el.textContent = "";
    let i = 0;
    setTimeout(function tick() {
      el.textContent = text.slice(0, ++i);
      if (i < text.length) setTimeout(tick, 70);
    }, 700);
  }
</script>

<style>
  .hero-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 0.2em;
    vertical-align: -0.12em;
    background: var(--accent);
    animation: cursor-blink 1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .hero-float {
    animation: float 3s steps(6) infinite alternate;
  }

  @keyframes float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cursor,
    .hero-float {
      animation: none;
    }
  }
</style>
