---
interface Props {
  index: string;
  title: string;
  subtitle: string;
}
const { index, title, subtitle } = Astro.props;
---

<div class="lg:col-span-4 lg:sticky lg:top-28">
  <p class="px-section-label">// {index}</p>
  <h2 class="mt-3 px-section-title text-4xl sm:text-5xl xl:text-6xl">{title}</h2>
  <p class="mt-3 text-sm text-[var(--muted)]">{subtitle}</p>
  <div class="px-steps mt-5" aria-hidden="true"><span></span><span></span><span></span></div>
</div>
