---
import { siteConfig } from "../config";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="mt-12">
  <div class="px-hazard"></div>
  <div class="bg-[var(--bg-2)] border-t-[3px] border-[var(--edge)]">
    <div
      class="mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-14 flex flex-col md:flex-row md:items-end md:justify-between gap-10"
    >
      <div>
        <p class="px-section-label">// CONTACT</p>
        <h3 class="mt-3 font-pixel text-3xl text-[var(--text)]" style="text-shadow: 3px 3px 0 var(--edge)">
          {siteConfig.name}
        </h3>
        <p class="mt-2 text-[var(--muted)]">{siteConfig.title}</p>
        {
          siteConfig.social.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="mt-4 inline-block font-pixel text-sm text-[var(--accent)] hover:underline"
            >
              {siteConfig.social.email}
            </a>
          )
        }
        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>

      <div class="font-pixel text-xs text-[var(--muted)] md:text-right space-y-2">
        <p class="flex items-center gap-2 md:justify-end">
          <span class="px-led"></span> BUILD OK
        </p>
        <p>© {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
        <a href="#hero" class="inline-block text-[var(--text)] hover:text-[var(--accent)]">▲ TOP</a>
      </div>
    </div>
  </div>
</footer>
