---
import { siteConfig } from "../config";

const nav = [
  { href: "#about", label: "About", show: true },
  { href: "#projects", label: "Projects", show: siteConfig.projects?.length > 0 },
  { href: "#experience", label: "Experience", show: siteConfig.experience?.length > 0 },
  { href: "#education", label: "Education", show: siteConfig.education?.length > 0 },
  { href: "#certifications", label: "Certs", show: siteConfig.certifications?.length > 0 },
].filter((item) => item.show);
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 hidden md:block">
  <nav class="mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-4 flex items-center justify-between">
    <a href="#hero" class="flex items-center gap-3 font-pixel text-[var(--text)]">
      <span class="logo-block" aria-hidden="true"></span>
      <span class="text-sm tracking-widest">KJS.DEV</span>
    </a>
    <ul class="flex items-center gap-1">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="nav-link font-pixel text-sm">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("header");
  const update = () => header?.classList.toggle("is-scrolled", window.scrollY > 80);
  window.addEventListener("scroll", update, { passive: true });
  update();
</script>

<style>
  header {
    transition: background-color 0.2s steps(2);
    border-bottom: 3px solid transparent;
  }

  header.is-scrolled {
    background-color: rgba(20, 23, 28, 0.92);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--edge);
    box-shadow: 0 3px 0 rgba(255, 255, 255, 0.04);
  }

  .logo-block {
    width: 18px;
    height: 18px;
    background: var(--accent);
    border: 3px solid var(--edge);
    box-shadow: 3px 3px 0 var(--edge);
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.85rem;
    color: var(--muted);
    border: 2px solid transparent;
    transition: color 0.1s steps(1);
  }

  .nav-link:hover {
    color: var(--edge);
    background: var(--accent);
    border-color: var(--edge);
  }
</style>
