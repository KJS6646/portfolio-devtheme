---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";
const hasCertifications =
  siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertifications && (
    <section id="certifications" class="px-6 py-20 sm:px-12 md:px-16 lg:px-24 lg:py-28">
      <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <SectionHeader index="05" title="CERTS" subtitle="자격증" />

        <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
          {siteConfig.certifications.map((cert) => (
            <div class="px-panel px-panel--hover p-5 flex items-start gap-4">
              <span class="cert-badge mt-1 w-8 h-8 shrink-0" aria-hidden="true" />
              <div class="min-w-0">
                <h3 class="font-bold text-[var(--text)]">{cert.name}</h3>
                <p class="text-sm text-[var(--muted)]">{cert.org}</p>
                <p class="mt-2 font-pixel text-xs text-[var(--accent)]">{cert.date}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .cert-badge {
    background: var(--accent);
    border: 3px solid var(--edge);
    box-shadow:
      inset 3px 3px 0 rgba(255, 255, 255, 0.35),
      inset -3px -3px 0 rgba(0, 0, 0, 0.25);
  }
</style>
